{
  "name": "buildkite-vscode",
  "displayName": "Buildkite",
  "description": "VS Code extension for Buildkite",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "buildkite",
          "title": "Buildkite",
          "icon": "resources/buildkite-icon.svg"
        }
      ]
    },
    "views": {
      "buildkite": [
        {
          "id": "buildkite.pipelines",
          "name": "Pipelines",
          "when": "buildkite.hasToken"
        },
        {
          "id": "buildkite.empty-view",
          "name": "",
          "when": "!buildkite.hasToken"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "buildkite.empty-view",
        "contents": "Sign in to Buildkite to view pipelines.\n[Set API Token](command:buildkite.setToken)",
        "when": "!buildkite.hasToken"
      }
    ],
    "commands": [
      {
        "command": "buildkite.setToken",
        "title": "Buildkite: Set API Token"
      },
      {
        "command": "buildkite.clearToken",
        "title": "Buildkite: Clear API Token"
      },
      {
        "command": "buildkite.listPipelines",
        "title": "Buildkite: List Pipelines"
      },
      {
        "command": "buildkite.listJobs",
        "title": "Buildkite: List Jobs"
      },
      {
        "command": "buildkite.pipelines.refresh",
        "title": "Refresh Pipelines",
        "category": "Buildkite",
        "icon": "$(refresh)"
      },
      {
        "command": "buildkite.build.open",
        "title": "View on Buildkite",
        "category": "Buildkite",
        "icon": "$(globe)"
      },
      {
        "command": "buildkite.build.retry",
        "title": "Retry Build",
        "category": "Buildkite",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "buildkite.pipelines.refresh",
          "group": "navigation",
          "when": "view == buildkite.pipelines"
        }
      ],
      "view/item/context": [
        {
          "command": "buildkite.build.open",
          "when": "viewItem == build",
          "group": "inline"
        },
        {
          "command": "buildkite.build.retry",
          "when": "viewItem == build",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/vscode": "^1.106.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0"
  }
}
