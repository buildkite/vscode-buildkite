{
  "name": "buildkite-vscode",
  "displayName": "Buildkite",
  "description": "VS Code extension for Buildkite",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=18.2.0"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "vscode.git",
    "redhat.vscode-yaml"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "buildkite",
          "title": "Buildkite",
          "icon": "resources/buildkite-icon.svg"
        }
      ]
    },
    "views": {
      "buildkite": [
        {
          "id": "buildkite.pipelines",
          "name": "Pipelines"
        },
        {
          "id": "buildkite.agents",
          "name": "Agents"
        },
        {
          "id": "buildkite.support",
          "name": "Support",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "buildkite.pipelines",
        "contents": "Sign in to Buildkite to manage your pipelines, builds and agents from VS Code.\n[Sign in](command:buildkite.signIn)\nNew to Buildkite?\n[Sign up](command:buildkite.signUp)",
        "when": "!buildkite.authenticated"
      },
      {
        "view": "buildkite.agents",
        "contents": "Sign in to Buildkite to see your agents.\n[Sign in](command:buildkite.signIn)\nNew to Buildkite?\n[Sign up](command:buildkite.signUp)",
        "when": "!buildkite.authenticated"
      }
    ],
    "commands": [
      {
        "command": "buildkite.searchDocs",
        "title": "Search Docs",
        "category": "Buildkite"
      },
      {
        "command": "buildkite.signIn",
        "title": "Sign In",
        "category": "Buildkite"
      },
      {
        "command": "buildkite.signUp",
        "title": "Sign Up",
        "category": "Buildkite"
      },
      {
        "command": "buildkite.signIn.OAuth",
        "title": "Sign In with OAuth",
        "category": "Buildkite"
      },
      {
        "command": "buildkite.signOut.OAuth",
        "title": "Sign Out of OAuth Session",
        "category": "Buildkite"
      },
      {
        "command": "buildkite.setToken",
        "title": "Set API Token",
        "category": "Buildkite"
      },
      {
        "command": "buildkite.clearToken",
        "title": "Clear API Token",
        "category": "Buildkite"
      },
      {
        "command": "buildkite.listPipelines",
        "title": "List Pipelines",
        "category": "Buildkite"
      },
      {
        "command": "buildkite.listJobs",
        "title": "List Jobs",
        "category": "Buildkite"
      },
      {
        "command": "buildkite.pipelines.refresh",
        "title": "Refresh Pipelines",
        "category": "Buildkite",
        "icon": "$(refresh)"
      },
      {
        "command": "buildkite.build.open",
        "title": "View on Buildkite",
        "category": "Buildkite",
        "icon": "$(globe)"
      },
      {
        "command": "buildkite.build.create",
        "title": "Create a build",
        "category": "Buildkite",
        "icon": "$(rocket)"
      },
      {
        "command": "buildkite.build.rebuild",
        "title": "Rebuild",
        "category": "Buildkite",
        "icon": "$(debug-restart)"
      },
      {
        "command": "buildkite.build.cancel",
        "title": "Cancel Build",
        "category": "Buildkite",
        "icon": "$(circle-slash)"
      },
      {
        "command": "buildkite.build.unblock",
        "title": "Unblock Next Job",
        "category": "Buildkite",
        "icon": "$(play)"
      },
      {
        "command": "buildkite.build.viewError",
        "title": "View Build Error",
        "category": "Buildkite",
        "icon": "$(error)"
      },
      {
        "command": "buildkite.build.viewAnnotations",
        "title": "View Annotations",
        "category": "Buildkite",
        "icon": "$(note)"
      },
      {
        "command": "buildkite.job.retry",
        "title": "Retry Job",
        "category": "Buildkite",
        "icon": "$(debug-restart)"
      },
      {
        "command": "buildkite.agents.refresh",
        "title": "Refresh Agents",
        "category": "Buildkite",
        "icon": "$(refresh)"
      },
      {
        "command": "buildkite.agents.filter",
        "title": "Filter Agents",
        "category": "Buildkite",
        "icon": "$(filter)"
      },
      {
        "command": "buildkite.agents.clearFilter",
        "title": "Clear Agent Filter",
        "category": "Buildkite",
        "icon": "$(close)"
      },
      {
        "command": "buildkite.agent.stop",
        "title": "Stop Agent",
        "category": "Buildkite",
        "icon": "$(debug-stop)"
      },
      {
        "command": "buildkite.agent.forceStop",
        "title": "Force Stop Agent",
        "category": "Buildkite",
        "icon": "$(error)"
      },
      {
        "command": "buildkite.agent.pause",
        "title": "Pause Agent",
        "category": "Buildkite",
        "icon": "$(debug-pause)"
      },
      {
        "command": "buildkite.agent.resume",
        "title": "Resume Agent",
        "category": "Buildkite",
        "icon": "$(play)"
      },
      {
        "command": "buildkite.artifact.download",
        "title": "Download Artifact",
        "category": "Buildkite",
        "icon": "$(cloud-download)"
      },
      {
        "command": "buildkite.job.unblock",
        "title": "Unblock Job",
        "category": "Buildkite",
        "icon": "$(play)"
      },
      {
        "command": "buildkite.job.viewJobLog",
        "title": "View Job Log in Output",
        "category": "Buildkite",
        "icon": "$(output)"
      },
      {
        "command": "buildkite.job.openJobLogUrl",
        "title": "Open Job Log in Browser",
        "category": "Buildkite",
        "icon": "$(browser)"
      },
      {
        "command": "buildkite.statusBar.showPipelines",
        "title": "Show Workspace Pipelines",
        "category": "Buildkite"
      },
      {
        "command": "buildkite.pipeline.create",
        "title": "Create Pipeline",
        "category": "Buildkite",
        "icon": "$(add)"
      },
      {
        "command": "buildkite.pipeline.edit",
        "title": "Edit Pipeline Settings",
        "category": "Buildkite",
        "icon": "$(edit)"
      },
      {
        "command": "buildkite.pipeline.archive",
        "title": "Archive Pipeline",
        "category": "Buildkite",
        "icon": "$(archive)"
      },
      {
        "command": "buildkite.pipeline.unarchive",
        "title": "Unarchive Pipeline",
        "category": "Buildkite",
        "icon": "$(archive)"
      },
      {
        "command": "buildkite.pipeline.delete",
        "title": "Delete Pipeline",
        "category": "Buildkite",
        "icon": "$(trash)"
      },
      {
        "command": "buildkite.pipelines.pick",
        "title": "Switch Pipeline",
        "category": "Buildkite",
        "icon": "$(list-flat)"
      }
    ],
    "keybindings": [
      {
        "command": "buildkite.pipelines.pick",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      }
    ],
    "configuration": {
      "title": "Buildkite",
      "properties": {
        "buildkite.statusBar.showWhenNoMatch": {
          "type": "boolean",
          "default": false,
          "description": "Show status bar even when no matching pipeline is found for the current workspace"
        },
        "buildkite.webBaseUrl": {
          "type": "string",
          "default": "https://buildkite.com",
          "description": "Base URL for the Buildkite web UI."
        },
        "buildkite.apiBaseUrl": {
          "type": "string",
          "default": "https://api.buildkite.com/v2",
          "description": "Base URL for the Buildkite REST API."
        },
        "buildkite.graphqlUrl": {
          "type": "string",
          "default": "https://graphql.buildkite.com/v1",
          "description": "Endpoint for the Buildkite GraphQL API."
        },
        "buildkite.oauth.clientId": {
          "type": "string",
          "default": "85bcd1d92d30dcb5e074",
          "description": "OAuth client ID to use when signing in with the browser."
        },
        "buildkite.oauth.scopePreset": {
          "type": "string",
          "enum": [
            "all",
            "read-only",
            "custom"
          ],
          "enumDescriptions": [
            "Request all supported Buildkite scopes (the server only grants scopes the user actually has permission for).",
            "Request read-only access to every Buildkite resource.",
            "Use the exact list of scopes configured in Buildkite > Oauth > Scopes."
          ],
          "default": "all",
          "description": "Which OAuth scopes to request at sign-in. Changes to this will take effect after signing out and back in."
        },
        "buildkite.oauth.scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "read_agents",
              "write_agents",
              "read_artifacts",
              "write_artifacts",
              "read_build_logs",
              "write_build_logs",
              "read_builds",
              "write_builds",
              "read_clusters",
              "write_clusters",
              "read_events",
              "read_job_env",
              "read_pipeline_templates",
              "write_pipeline_templates",
              "read_pipelines",
              "write_pipelines",
              "read_rules",
              "write_rules",
              "read_organizations",
              "read_teams",
              "write_teams",
              "read_user",
              "read_secrets_details",
              "write_secrets",
              "read_suites",
              "write_suites",
              "read_test_plan",
              "write_test_plan",
              "read_packages",
              "write_packages",
              "delete_packages",
              "read_registries",
              "write_registries",
              "delete_registries",
              "read_portals",
              "write_portals"
            ]
          },
          "default": [],
          "description": "Custom list of Buildkite OAuth scopes to request. Only used when Buildkite > Oauth > Scope Preset is set to \"custom\". Changes to this will take effect after signing out and back in."
        },
        "buildkite.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when builds complete"
        },
        "buildkite.notifications.notifyOnPass": {
          "type": "boolean",
          "default": true,
          "description": "Show notification when a build passes"
        },
        "buildkite.notifications.notifyOnFail": {
          "type": "boolean",
          "default": true,
          "description": "Show notification when a build fails"
        },
        "buildkite.notifications.notifyOnAllBuilds": {
          "type": "boolean",
          "default": false,
          "description": "Show notifications for builds that were already completed when first seen"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "buildkite.pipelines.pick",
          "group": "navigation",
          "when": "view == buildkite.pipelines"
        },
        {
          "command": "buildkite.pipelines.refresh",
          "group": "navigation",
          "when": "view == buildkite.pipelines"
        },
        {
          "command": "buildkite.agents.refresh",
          "group": "navigation",
          "when": "view == buildkite.agents"
        },
        {
          "command": "buildkite.agents.filter",
          "group": "navigation",
          "when": "view == buildkite.agents"
        },
        {
          "command": "buildkite.agents.clearFilter",
          "group": "navigation",
          "when": "view == buildkite.agents && buildkite.agents.filterActive"
        },
        {
          "command": "buildkite.pipeline.create",
          "group": "navigation",
          "when": "view == buildkite.pipelines"
        }
      ],
      "view/item/context": [
        {
          "command": "buildkite.build.open",
          "when": "viewItem =~ /^build/ || viewItem == build:blocked",
          "group": "inline"
        },
        {
          "command": "buildkite.build.rebuild",
          "when": "viewItem =~ /^build/ || viewItem == build:blocked",
          "group": "inline@2"
        },
        {
          "command": "buildkite.build.cancel",
          "when": "viewItem =~ /^build-(creating|scheduled|running|failing|blocked)$/",
          "group": "inline"
        },
        {
          "command": "buildkite.artifact.download",
          "when": "viewItem == artifact",
          "group": "inline"
        },
        {
          "command": "buildkite.build.open",
          "when": "viewItem =~ /^build/ || viewItem == build:blocked",
          "group": "navigation@1"
        },
        {
          "command": "buildkite.build.rebuild",
          "when": "viewItem =~ /^build/ || viewItem == build:blocked",
          "group": "navigation@2"
        },
        {
          "command": "buildkite.build.cancel",
          "when": "viewItem =~ /^build-(creating|scheduled|running|failing|blocked)/ || viewItem =~ /:blocked$/",
          "group": "navigation@3"
        },
        {
          "command": "buildkite.build.unblock",
          "when": "viewItem =~ /:blocked$/",
          "group": "navigation@4"
        },
        {
          "command": "buildkite.build.create",
          "when": "viewItem == pipeline",
          "group": "inline"
        },
        {
          "command": "buildkite.job.retry",
          "when": "viewItem == job.retriable",
          "group": "inline"
        },
        {
          "command": "buildkite.agent.stop",
          "when": "viewItem == agent.connected || viewItem == agent.connected.paused || viewItem == agent.connected.running || viewItem == agent.connected.paused.running",
          "group": "inline"
        },
        {
          "command": "buildkite.agent.pause",
          "when": "viewItem == agent.connected || viewItem == agent.connected.running",
          "group": "inline"
        },
        {
          "command": "buildkite.agent.resume",
          "when": "viewItem == agent.connected.paused || viewItem == agent.connected.paused.running",
          "group": "inline"
        },
        {
          "command": "buildkite.agent.forceStop",
          "when": "viewItem == agent.connected.running || viewItem == agent.connected.paused.running",
          "group": "inline"
        },
        {
          "command": "buildkite.build.viewAnnotations",
          "when": "viewItem =~ /^build/",
          "group": "inline@3"
        },
        {
          "command": "buildkite.build.viewAnnotations",
          "when": "viewItem =~ /^build/",
          "group": "navigation@5"
        },
        {
          "command": "buildkite.job.unblock",
          "when": "viewItem =~ /^job\\.unblockable/",
          "group": "inline@2"
        },
        {
          "command": "buildkite.job.viewJobLog",
          "when": "viewItem =~ /^job/",
          "group": "inline@3"
        },
        {
          "command": "buildkite.job.viewJobLog",
          "when": "viewItem =~ /^job/",
          "group": "navigation@1"
        },
        {
          "command": "buildkite.job.openJobLogUrl",
          "when": "viewItem =~ /^job/",
          "group": "navigation@2"
        },
        {
          "command": "buildkite.job.retry",
          "when": "viewItem == job.retriable",
          "group": "actions@1"
        },
        {
          "command": "buildkite.job.unblock",
          "when": "viewItem =~ /^job\\.unblockable/",
          "group": "actions@2"
        },
        {
          "command": "buildkite.pipeline.edit",
          "when": "viewItem =~ /^pipeline/",
          "group": "pipeline@1"
        },
        {
          "command": "buildkite.pipeline.archive",
          "when": "viewItem == pipeline",
          "group": "pipeline@2"
        },
        {
          "command": "buildkite.pipeline.unarchive",
          "when": "viewItem == pipeline.archived",
          "group": "pipeline@2"
        },
        {
          "command": "buildkite.pipeline.delete",
          "when": "viewItem =~ /^pipeline/",
          "group": "pipeline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "buildkite.pipeline.edit",
          "when": "false"
        },
        {
          "command": "buildkite.pipeline.archive",
          "when": "false"
        },
        {
          "command": "buildkite.pipeline.unarchive",
          "when": "false"
        },
        {
          "command": "buildkite.pipeline.delete",
          "when": "false"
        },
        {
          "command": "buildkite.build.viewError",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@types/vscode": "^1.106.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "overrides": {
    "@vscode/test-cli": {
      "serialize-javascript": "^7.0.5"
    }
  },
  "dependencies": {
    "ansi-to-html": "^0.7.2"
  }
}