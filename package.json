{
  "name": "buildkite-vscode",
  "displayName": "Buildkite",
  "description": "VS Code extension for Buildkite",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "vscode.git",
    "redhat.vscode-yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "buildkite",
          "title": "Buildkite",
          "icon": "resources/buildkite-icon.svg"
        }
      ]
    },
    "views": {
      "buildkite": [
        {
          "id": "buildkite.pipelines",
          "name": "Pipelines"
        }
      ]
    },
    "commands": [
      {
        "command": "buildkite.setToken",
        "title": "Buildkite: Set API Token"
      },
      {
        "command": "buildkite.clearToken",
        "title": "Buildkite: Clear API Token"
      },
      {
        "command": "buildkite.listPipelines",
        "title": "Buildkite: List Pipelines"
      },
      {
        "command": "buildkite.listJobs",
        "title": "Buildkite: List Jobs"
      },
      {
        "command": "buildkite.pipelines.refresh",
        "title": "Refresh Pipelines",
        "category": "Buildkite",
        "icon": "$(refresh)"
      },
      {
        "command": "buildkite.build.open",
        "title": "View on Buildkite",
        "category": "Buildkite",
        "icon": "$(globe)"
      },
      {
        "command": "buildkite.build.rebuild",
        "title": "Rebuild",
        "category": "Buildkite",
        "icon": "$(debug-restart)"
      },
      {
        "command": "buildkite.build.cancel",
        "title": "Cancel Build",
        "category": "Buildkite",
        "icon": "$(circle-slash)"
      },
      {
        "command": "buildkite.job.retry",
        "title": "Retry Job",
        "category": "Buildkite",
        "icon": "$(debug-restart)"
      },
      {
        "command": "buildkite.artifact.download",
        "title": "Download Artifact",
        "category": "Buildkite",
        "icon": "$(cloud-download)"
      },
      {
        "command": "buildkite.statusBar.showPipelines",
        "title": "Buildkite: Show Workspace Pipelines"
      }
    ],
    "configuration": {
      "title": "Buildkite",
      "properties": {
        "buildkite.statusBar.showWhenNoMatch": {
          "type": "boolean",
          "default": false,
          "description": "Show status bar even when no matching pipeline is found for the current workspace"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "buildkite.pipelines.refresh",
          "group": "navigation",
          "when": "view == buildkite.pipelines"
        }
      ],
      "view/item/context": [
        {
          "command": "buildkite.build.open",
          "when": "viewItem == build",
          "group": "inline"
        },
        {
          "command": "buildkite.build.rebuild",
          "when": "viewItem == build",
          "group": "inline"
        },
        {
          "command": "buildkite.build.cancel",
          "when": "viewItem =~ /^build-(creating|scheduled|running|failing|blocked)$/",
          "group": "inline"
        },
        {
          "command": "buildkite.job.retry",
          "when": "viewItem == job.retriable",
          "group": "inline"
        },
        {
          "command": "buildkite.artifact.download",
          "when": "viewItem == artifact",
          "group": "inline"
        },
        {
          "command": "buildkite.build.open",
          "when": "viewItem == build",
          "group": "navigation@1"
        },
        {
          "command": "buildkite.build.rebuild",
          "when": "viewItem == build",
          "group": "navigation@2"
        },
        {
          "command": "buildkite.build.cancel",
          "when": "viewItem =~ /^build-(creating|scheduled|running|failing|blocked)$/",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/vscode": "^1.106.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0"
  }
}
